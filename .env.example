# Frontend runtime settings
VITE_API_URL=http://127.0.0.1:8000/api
VITE_API_TIMEOUT_MS=45000

# Supabase public settings (safe for frontend usage)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# IMPORTANT:
# Never place private secrets (API private keys, client secrets, service-role keys)
# in VITE_* variables. These values are bundled into client code.
