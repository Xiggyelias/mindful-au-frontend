# Frontend runtime settings
VITE_API_URL=http://127.0.0.1:8000/api
VITE_API_TIMEOUT_MS=45000

# Supabase public settings (safe for frontend usage)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# WebRTC signaling/media relay configuration
VITE_WEBRTC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302","stun:stun1.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp"],"username":"turn-user","credential":"turn-password"}]
VITE_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
VITE_WEBRTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
VITE_WEBRTC_TURN_USERNAME=turn-user
VITE_WEBRTC_TURN_CREDENTIAL=turn-password

# Public landing page crisis line (defaults to Youth Advocates Helpline / tel:393 if omitted)
# VITE_CRISIS_HOTLINE_TEL=393
# VITE_CRISIS_HOTLINE_LABEL=Youth Advocates Helpline: Call 393

